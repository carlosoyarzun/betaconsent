# Plantilla (sin secretos). Real: /etc/consent/reconciler.env, root:root, modo 0600.
# ADR-010 rev. 5 §2 (G-9): el reconciler solo necesita estas dos variables. NO lleva claves K_sub, parametros del IdP ni la credencial de ningun otro rol.
# Prohibido en este entorno: PGOPTIONS, PGUSER, PGPASSWORD, PGSERVICE, PGSERVICEFILE, PGPASSFILE, variables *MIGRATOR* y parametros de query fuera de sslmode/sslrootcert/connect_timeout (assertSafeConnectionUrl).
CNS_ENVIRONMENT=LOCAL
CNS_DATABASE_URL=postgresql://integrity_reconciler:<SECRETO>@<host>:5432/<db>
