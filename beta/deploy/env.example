# /etc/consent-beta/consent.env (root:consent 0640). Plantilla de beta/deploy: SIN valores secretos; reemplaza todo CHANGE_ME y los marcadores.
# H1: solo datos sintéticos y destinatarios de prueba. El único modo soportado es LOCAL (catálogo SYNTHETIC); REAL es H2-08.
# Entorno: debe coincidir con ops.db_catalog (LOCAL = SYNTHETIC; con LOCAL solo se envía a CNS_MAIL_ALLOWLIST).
CNS_ENVIRONMENT=LOCAL
# Pool HTTP: rol consent_app (no emite OTP ni tokens). Contraseña = app_password de bootstrap-roles.sql (si trae caracteres especiales, codifícala como URL).
CNS_DATABASE_URL=postgresql://consent_app:CHANGE_ME@127.0.0.1:5432/consent
# Pool del mailer: rol consent_mailer (único que emite OTP/tokens). Debe ser distinto del anterior; main.ts aborta si un pool no conecta con su rol.
CNS_MAILER_DATABASE_URL=postgresql://consent_mailer:CHANGE_ME@127.0.0.1:5432/consent
# Solo para `npm run migrate` (rol consent_migrator); el servicio no la usa. Puedes dejarla aquí o exportarla a mano al migrar.
CNS_MIGRATOR_DATABASE_URL=postgresql://consent_migrator:CHANGE_ME@127.0.0.1:5432/consent
# Secreto de sesión: base64 de al menos 32 bytes. Genera con: openssl rand -base64 32
CNS_SESSION_SECRET=CHANGE_ME_BASE64_32_BYTES
# Origen público (HTTPS, sin barra final): se usa en los enlaces de los correos.
CNS_PUBLIC_ORIGIN=https://consent.lectorpro.cl
# SMTP con TLS obligatorio: smtps://usuario:clave@host:465 o smtp://usuario:clave@host:587 (STARTTLS). Codifica como URL los caracteres especiales.
CNS_SMTP_URL=smtps://CHANGE_ME_USER:CHANGE_ME_PASS@smtp.CHANGE_ME.invalid:465
# Remitente (debe estar autorizado en tu cuenta SMTP).
CNS_SMTP_FROM=no-reply@CHANGE_ME.invalid
# Allowlist de destinatarios de prueba (correos o @dominios, separados por coma). Solo estos reciben correo mientras el catálogo sea SYNTHETIC.
CNS_MAIL_ALLOWLIST=buzon-de-prueba@CHANGE_ME.invalid
# Claves de la API de importación: keyId:secretoBase64[,keyId2:secretoBase64]. El secreto: openssl rand -base64 32
CNS_API_KEYS=importador:CHANGE_ME_BASE64_32_BYTES
# Puerto y dirección de escucha: loopback; Caddy es el único que expone el servicio (si cambias PORT, cambia también el Caddyfile).
PORT=3000
BIND=127.0.0.1
