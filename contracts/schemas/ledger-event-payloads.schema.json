          "$ref": "common.schema.json#/$defs/PurposeChoice"
        }
      },
      "required": [
        "consentId",
        "purpose",
        "choice"
      ]
    },
    "CONSENT_GRANTED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "chainRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "consentVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "consentTextHash": {
          "$ref": "common.schema.json#/$defs/Sha256Hex"
        }
      },
      "required": [
        "consentId",
        "chainRef",
        "consentVersion",
        "consentTextHash"
      ]
    },
    "CONSENT_DECLINED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "chainRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "consentVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "consentTextHash": {
          "$ref": "common.schema.json#/$defs/Sha256Hex"
        }
      },
      "required": [
        "consentId",
        "chainRef",
        "consentVersion",
        "consentTextHash"
      ]
    },
    "RECEIPT_CREATED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receiptRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "managementLinkIssued": {
          "type": "boolean"
        }
      },
      "required": [
        "receiptRef",
        "managementLinkIssued"
      ]
    },
    "CONSENT_REVOKED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "revokedDecisionRef": {
          "$ref": "common.schema.json#/$defs/Ref",
          "x-pending": [
            "F-002 (revokedDecisionRef, R14-C, sin enmienda en Notion)"
          ]
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/RevocationScope"
        },
        "effectiveAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "authPath": {
          "$ref": "common.schema.json#/$defs/AuthPath"
        },
        "recoveryMethod": {
          "$ref": "common.schema.json#/$defs/RecoveryMethod"
        },
        "originPurposeRef": {
          "$ref": "common.schema.json#/$defs/OriginPurposeRef"
        }
      },
      "required": [
        "revocationRef",
        "revokedDecisionRef",
        "scope",
        "effectiveAt",
        "authPath",
        "originPurposeRef"
      ],
      "description": "effectiveAt = hora del append (RULE-CNS-025). authPath/recoveryMethod = los del REVOCATION_VERIFIED previo a la confirmación (GRD-RV-28). Validez con falla de clave: LD-05.",
      "allOf": [
        {
          "if": {
            "properties": {
              "authPath": {
                "const": "RECOVERY"
              }
            },
            "required": [
              "authPath"
            ]
          },
          "then": {
            "required": [
              "recoveryMethod"
            ]
          },
          "else": {
            "not": {
              "required": [
                "recoveryMethod"
              ]
            }
          }
        }
      ]
    },
    "REVOCATION_REQUESTED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "revokedDecisionRef": {
          "$ref": "common.schema.json#/$defs/Ref",
          "x-pending": [
            "F-002 (revokedDecisionRef, R14-C, sin enmienda en Notion)"
          ]
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/RevocationScope"
        },
        "authPath": {
          "$ref": "common.schema.json#/$defs/AuthPath"
        },
        "recoveryMethod": {
          "$ref": "common.schema.json#/$defs/RecoveryMethod"
        },
        "originPurposeRef": {
          "$ref": "common.schema.json#/$defs/OriginPurposeRef"
        },
        "initiatedVia": {
          "$ref": "common.schema.json#/$defs/InitiatedVia"
        },
        "recoveryRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "caseRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "revocationRef",
        "revokedDecisionRef",
        "scope",
        "authPath",
        "originPurposeRef",
        "initiatedVia"
      ],
      "description": "initiatedVia derivado en servidor (GRD-RV-25).",
      "allOf": [
        {
          "if": {
            "properties": {
              "authPath": {
                "const": "RECOVERY"
              }
            },
            "required": [
              "authPath"
            ]
          },
          "then": {
            "required": [
              "recoveryMethod"
            ]
          },
          "else": {
            "not": {
              "required": [
                "recoveryMethod"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "recoveryMethod": {
                "const": "CHANNEL_LINK"
              }
            },
            "required": [
              "recoveryMethod"
            ]
          },
          "then": {
            "required": [
              "recoveryRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "recoveryMethod": {
                "const": "HUMAN_ASSISTED"
              }
            },
            "required": [
              "recoveryMethod"
            ]
          },
          "then": {
            "required": [
              "caseRef"
            ]
          }
        }
      ]
    },
    "REVOCATION_VERIFIED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "authPath": {
          "$ref": "common.schema.json#/$defs/AuthPath"
        },
        "recoveryMethod": {
          "$ref": "common.schema.json#/$defs/RecoveryMethod"
        },
        "assuranceLevel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,32}$",
          "x-pending": [
            "LD-02 / OPEN-RV-01 (valores de assuranceLevel; placeholder versionado)"
          ]
        },
        "verificationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "recoveryRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "caseRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "verifiedByRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "secondApproverRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "revocationRef",
        "authPath",
        "assuranceLevel"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "authPath": {
                "const": "RECOVERY"
              }
            },
            "required": [
              "authPath"
            ]
          },
          "then": {
            "required": [
              "recoveryMethod"
            ]
          },
          "else": {
            "not": {
              "required": [
                "recoveryMethod"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "authPath": {
                "const": "OTP"
              }
            },
            "required": [
              "authPath"
            ]
          },
          "then": {
            "required": [
              "verificationRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "recoveryMethod": {
                "const": "CHANNEL_LINK"
              }
            },
            "required": [
              "recoveryMethod"
            ]
          },
          "then": {
            "required": [
              "recoveryRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "recoveryMethod": {
                "const": "HUMAN_ASSISTED"
              }
            },
            "required": [
              "recoveryMethod"
            ]
          },
          "then": {
            "required": [
              "caseRef",
              "verifiedByRef",
              "secondApproverRef"
            ]
          }
        }
      ]
    },
    "REVOCATION_CONFIRMED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "recordedByRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "cosignedByRef": {
          "$ref": "common.schema.json#/$defs/Ref",
          "description": "Co-firmante de RH3 (segundo RIGHTS_OPERATOR distinto, F-R14-04). Ref opaca del principal de plataforma; nunca email, nombre ni sub del IdP."
        }
      },
      "required": [
        "revocationRef"
      ],
      "description": "recordedByRef y cosignedByRef solo en HUMAN_ASSISTED (RH3), ambos o ninguno; R3 y R3r no llevan ninguno (lista blanca, INV-CM-05). cosignedByRef ≠ recordedByRef (CHECK de DB, INV-RV-11; no expresable en JSON Schema): un append de RH3 sin cosignedByRef o con ambos iguales falla sin CONFIRMED ni job.",
      "x-pending": [
        "F-003",
        "OPEN-RV-11 (PENDING-CARLOS: cosignedByRef como campo nuevo de DEC-BR-017 §6 y del payload de SM v7 §5.2 RH3)"
      ],
      "dependentRequired": {
        "recordedByRef": [
          "cosignedByRef"
        ],
        "cosignedByRef": [
          "recordedByRef"
        ]
      },
      "x-governed-by": [
        "revocation.spec REVOCATION_CONFIRMED, INV-RV-11",
        "F-R14-04",
        "CARLOS r3 R14-B",
        "DEC-BR-017 §6"
      ]
    },
    "REVOCATION_DOWNSTREAM_EMITTED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "subscriptionRefs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Ref"
          },
          "uniqueItems": true,
          "description": "Destinos congelados en R5 (SEC P2-08)."
        }
      },
      "required": [
        "revocationRef",
        "subscriptionRefs"
      ]
    },
    "REVOCATION_DELIVERED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
