# Gobierna: ADR-010 rev. 4 §7 fila PR-6 ("unidades en infra/ (ADR-003); pools por rol"), INV-DBR-02 (web = app_rw), ADR-003 rev. 7 (host dedicado de LectorPro, sin proveedor cloud).
# ARTEFACTO de IT0 (EXIT-LOCAL, solo datos sinteticos): NO se instala ni se ejecuta en este repo; sin despliegue. Un usuario de SO por proceso (consent-web), un rol LOGIN de Postgres por proceso.
# La credencial va SOLO en /etc/consent/web.env (modo 0600, dueno consent-web); nunca en el repo. Plantilla de variables: infra/systemd/web.env.example.
[Unit]
Description=Consent App - Proceso web (HTTP del titular y de la escuela) (rol app_rw)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=consent-web
Group=consent-web
WorkingDirectory=/opt/consent-app
EnvironmentFile=/etc/consent/web.env
ExecStart=/usr/bin/node /opt/consent-app/src/server/entrypoints/web/main.ts
Restart=on-failure
RestartSec=5s
# Fail-closed al arranque (rol equivocado, catalogo/environment distinto, membresias): el proceso sale con codigo 1; no reintentar en bucle apretado.
StartLimitIntervalSec=60
StartLimitBurst=5

# Aislamiento del proceso
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Red: sin salidas a internet. Solo loopback (Postgres en el mismo host dedicado; si la base va en otro host, el IPAddressAllow se completa en la primera historia de infraestructura).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
