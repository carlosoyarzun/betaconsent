# Variables de beta/ (loadConfig). Valores de EJEMPLO: ninguno es un secreto real. No commitear un .env con valores reales.
CNS_ENVIRONMENT=LOCAL
# Pool HTTP: rol consent_app (no puede emitir OTP ni tokens de invitación).
CNS_DATABASE_URL=postgresql://consent_app:CHANGE_ME@127.0.0.1:5432/consent
# Pool del mailer: rol consent_mailer (único con EXECUTE de issue_otp y arm_invitation_token; SEC-CNS-024-V1). Debe ser distinta de CNS_DATABASE_URL.
CNS_MAILER_DATABASE_URL=postgresql://consent_mailer:CHANGE_ME@127.0.0.1:5432/consent
# Solo para `npm run migrate` (rol consent_migrator).
CNS_MIGRATOR_DATABASE_URL=postgresql://consent_migrator:CHANGE_ME@127.0.0.1:5432/consent
CNS_SESSION_SECRET=BASE64_DE_AL_MENOS_32_BYTES
CNS_PUBLIC_ORIGIN=http://localhost:8080
CNS_SMTP_URL=smtp://127.0.0.1:1025
CNS_SMTP_FROM=no-reply@consent.example.invalid
CNS_MAIL_ALLOWLIST=@pruebas.example.invalid
CNS_API_KEYS=keyId:BASE64_DE_AL_MENOS_32_BYTES
PORT=8080
BIND=127.0.0.1
