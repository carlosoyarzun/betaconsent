      ]
    },
    "INVITATION_VERIFIED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "verificationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "decisionMakerRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "bindingResult": {
          "type": "string",
          "pattern": "^[A-Z_]{1,40}$",
          "x-pending": [
            "OPEN-CT-03 (enum de bindingResult no definido en la spec)"
          ]
        }
      },
      "required": [
        "invitationRef",
        "verificationRef",
        "decisionMakerRef",
        "bindingResult"
      ]
    },
    "INVITATION_COMPLETED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "invitationRef",
        "consentId"
      ]
    },
    "INVITATION_DECLINED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "invitationRef",
        "consentId"
      ]
    },
    "INVITATION_EXPIRED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "invitationRef"
      ]
    },
    "INVITATION_CANCELLED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "reasonCode": {
          "enum": [
            "INVITER_WITHDRAWN",
            "SUBJECT_MISMATCH_REPORTED",
            "TOKEN_COMPROMISED",
            "PARTICIPATION_CLOSED",
            "ENROLLMENT_CLOSED"
          ],
          "description": "CONTESTED_BY_RECIPIENT excluido: deshabilitado en IT0 (LD-01)."
        }
      },
      "required": [
        "invitationRef",
        "reasonCode"
      ]
    },
    "DECISION_MAKER_CHANNEL_VERIFIED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verificationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "parentRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "decisionMakerRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/OtpScope"
        },
        "method": {
          "const": "EMAIL_OTP"
        },
        "bindingResult": {
          "type": "string",
          "pattern": "^[A-Z_]{1,40}$",
          "x-pending": [
            "OPEN-CT-03 (enum de bindingResult no definido en la spec)"
          ]
        }
      },
      "required": [
        "verificationRef",
        "parentRef",
        "decisionMakerRef",
        "scope",
        "method",
        "bindingResult"
      ]
    },
    "CONTEXT_INFORMATION_VIEWED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "consentId"
      ]
    },
    "CONSENT_VERSION_VIEWED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "consentVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "consentTextHash": {
          "$ref": "common.schema.json#/$defs/Sha256Hex"
        },
        "privacyNoticeVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        }
      },
      "required": [
        "consentId",
        "consentVersion",
        "consentTextHash",
        "privacyNoticeVersion"
      ]
    },
    "DECISION_MAKER_AUTHORITY_DECLARED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "relationshipRef": {
          "type": "string",
          "pattern": "^[A-Z_]{1,40}$",
          "x-pending": [
            "DEC-BR-003 / EXT-A / LD-01"
          ]
        }
      },
      "required": [
        "consentId",
        "relationshipRef"
      ]
    },
    "SUBJECT_CONFIRMED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consentId": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "subjectRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "consentId",
        "subjectRef"
      ],
      "x-pending": [
        "DEC-BR-004 / EXT-C"
      ]
    },
    "PURPOSE_DECISION_RECORDED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
