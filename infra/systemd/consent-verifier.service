# Gobierna: ADR-010 rev. 4 §7 fila PR-6 ("unidades en infra/ (ADR-003); pools por rol"), INV-DBR-02 (verifier = integrity_verifier), ADR-003 rev. 7 (host dedicado de LectorPro, sin proveedor cloud).
# ARTEFACTO de IT0 (EXIT-LOCAL, solo datos sinteticos): NO se instala ni se ejecuta en este repo; sin despliegue. Un usuario de SO por proceso (consent-verifier), un rol LOGIN de Postgres por proceso.
# La credencial va SOLO en /etc/consent/verifier.env (root:root, modo 0600: systemd la lee como root antes de bajar privilegios; el proceso no necesita leerla); nunca en el repo. Plantilla de variables: infra/systemd/verifier.env.example.
[Unit]
Description=Consent App - Proceso verifier (unico con egress al IdP; sin HTTP) (rol integrity_verifier)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=consent-verifier
Group=consent-verifier
WorkingDirectory=/opt/consent-app
EnvironmentFile=/etc/consent/verifier.env
ExecStart=/usr/bin/node /opt/consent-app/src/server/entrypoints/verifier/main.ts
Restart=on-failure
RestartSec=5s
# Fail-closed al arranque (rol equivocado, catalogo/environment distinto, membresias): el proceso sale con codigo 1; no reintentar en bucle apretado.
StartLimitIntervalSec=60
StartLimitBurst=5

# Aislamiento del proceso
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
RestrictRealtime=true
RemoveIPC=true

# Red: sin salidas a internet. Solo loopback (Postgres en el mismo host dedicado; si la base va en otro host, el IPAddressAllow se completa en la primera historia de infraestructura).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
# El verifier es el UNICO proceso que tendra egress (token endpoint + JWKS del IdP) y solo por el proxy de egress. P-45 (limites del proxy) NO esta aprobado y APR-IDP es PENDING:
# por eso NO se abre ninguna salida aqui; el IdP real esta apagado (PR-6b) y el verifier fuera de LOCAL no arranca.

[Install]
WantedBy=multi-user.target
