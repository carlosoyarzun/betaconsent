# macOS
.DS_Store

# Claude Code local state (worktrees y settings locales)
.claude/worktrees/
.claude/settings.local.json

# Log local de hooks (no es evidencia versionada)
agent/audit.log

# Secrets / entornos
.env
.env.*
!.env.example

# Dependencias y builds (para cuando exista código)
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc
.venv/

# Excepción: el corpus de evasión de SEC-CNS-010 (CA-136) versiona a propósito
# directorios llamados node_modules/dist bajo src/ como fixtures negativas del
# guardrail Ports & Adapters (deben commitearse, no son dependencias reales).
!tests/guardrails/ports-adapters/fixtures/**/node_modules/
!tests/guardrails/ports-adapters/fixtures/**/dist/
