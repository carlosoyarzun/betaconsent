# Gobierna: ADR-010 rev. 4 §7 fila PR-6 ("unidades en infra/ (ADR-003); pools por rol"), INV-DBR-02 (worker = worker), ADR-003 rev. 7 (host dedicado de LectorPro, sin proveedor cloud).
# ARTEFACTO de IT0 (EXIT-LOCAL, solo datos sinteticos): NO se instala ni se ejecuta en este repo; sin despliegue. Un usuario de SO por proceso (consent-worker), un rol LOGIN de Postgres por proceso.
# La credencial va SOLO en /etc/consent/worker.env (root:root, modo 0600: systemd la lee como root antes de bajar privilegios; el proceso no necesita leerla); nunca en el repo. Plantilla de variables: infra/systemd/worker.env.example.
[Unit]
Description=Consent App - Proceso worker (outbox, R5-R7, purga; sin HTTP) (rol worker)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=consent-worker
Group=consent-worker
WorkingDirectory=/opt/consent-app
EnvironmentFile=/etc/consent/worker.env
ExecStart=/usr/bin/node /opt/consent-app/src/server/entrypoints/worker/main.ts
Restart=on-failure
RestartSec=5s
# Fail-closed al arranque (rol equivocado, catalogo/environment distinto, membresias): el proceso sale con codigo 1; no reintentar en bucle apretado.
StartLimitIntervalSec=60
StartLimitBurst=5

# Aislamiento del proceso
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
SystemCallFilter=@system-service
RestrictRealtime=true
RemoveIPC=true

# Red: sin salidas a internet. Solo loopback (Postgres en el mismo host dedicado; si la base va en otro host, el IPAddressAllow se completa en la primera historia de infraestructura).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
