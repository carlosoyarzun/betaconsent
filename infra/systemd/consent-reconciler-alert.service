# Gobierna: ADR-010 rev. 5 §4.2.c y §10 fila 6e; seguridad PR #99 P2-7. Unidad de ALERTA LOCAL del reconciler: se activa por OnFailure= de consent-reconciler.service (exit 1 o 2).
# Solo escribe una linea de severidad `crit` en el journal local (sin PII, sin egress): el detalle (ids opacos, tipo de divergencia, conteos) ya esta en el journal de consent-reconciler.service.
# Quien monitorea el journal del host (alerta humana) es una decision de infraestructura PENDING (IT0b). ARTEFACTO de IT0: no se instala en este repo.
[Unit]
Description=Consent App - Alerta local: el reconciler fallo o encontro divergencias

[Service]
Type=oneshot
User=consent-reconciler
Group=consent-reconciler
ExecStart=/usr/bin/logger -p user.crit -t consent-reconciler "ALERTA reconciler: fallo o divergencias; ver journalctl -u consent-reconciler.service (sin PII)"
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Sin red: el logger usa el socket local de syslog/journal (AF_UNIX).
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
