# Plantilla (sin secretos). Real: /etc/consent/verifier.env, root:root, modo 0600.
# Sin defaults para parametros PENDING: P-36 (CNS_VERIFIER_MAX_AUTH_AGE_SECONDS) y los valores de APR-IDP los fija Carlos / studio.
CNS_ENVIRONMENT=LOCAL
CNS_DATABASE_URL=postgresql://integrity_verifier:<SECRETO>@<host>:5432/<db>
CNS_VERIFIER_ISSUER=<issuer>
CNS_VERIFIER_AUDIENCE=<audience>
CNS_VERIFIER_MAX_AUTH_AGE_SECONDS=<PENDING P-36>
CNS_VERIFIER_REQUIRED_ACR_ANY_OF=<PENDING APR-IDP; obligatorio fuera de LOCAL>
CNS_VERIFIER_SUB_HMAC_KEY_HEX=<K_sub hex, >=32 bytes, SecretStore (F-X8-09 pendiente)>

# ADR-010 rev. 5 PR-6b (G-6, G-7): limites del login. OBLIGATORIOS fuera de LOCAL (las tres juntas; sin ellas el verifier no arranca). Valores iniciales aprobados el 2026-10-15.
# CNS_VERIFIER_P48_MAX_FAILURES=5
# CNS_VERIFIER_P48_WINDOW_SECONDS=900
# CNS_VERIFIER_P52_ASSERTION_SECONDS=300
# CNS_VERIFIER_SUB_KEY_VERSION=1
