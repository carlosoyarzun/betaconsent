  "$defs": {
    "TenantStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantRef": {
          "$ref": "common.schema.json#/$defs/TenantRef"
        },
        "state": {
          "enum": [
            "ACTIVE",
            "SUSPENDED"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "tenantRef",
        "state",
        "sequence"
      ],
      "description": "tenant.active solo alimenta eligibility_to_participate (GRD-CM-05); nunca eligibility_to_revoke (INV-TC-01)."
    },
    "SchoolParticipation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
