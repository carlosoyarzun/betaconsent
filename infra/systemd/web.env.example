# Plantilla (sin secretos). Real: /etc/consent/web.env, root:root, modo 0600. Solo LOCAL en IT0 (el unico servidor web es dev.ts, datos sinteticos).
# Plantilla consolidada de todos los procesos y con su significado linea a linea: tools/deploy/.env.example (la genera tools/deploy/install.sh).
CNS_ENVIRONMENT=LOCAL
CONSENT_STORE=postgres
CNS_DATABASE_URL=postgresql://app_rw:<SECRETO>@<host>:5432/<db>
# OBLIGATORIAS (el proceso no arranca sin ellas; antes faltaban en esta plantilla). base64 estricto de >= 32 bytes, una distinta por proposito.
# Origen publico exacto, con esquema y sin barra final (valida Origin de los POST). Cookies __Host-*: Secure, exigen https (nginx termina TLS).
CNS_ALLOWED_ORIGIN=<https://dominio-publico>
CNS_SESSION_SECRET=<base64-32-bytes>
CNS_OTP_SECRET=<base64-32-bytes>
# En LOCAL son opcionales (constante publica de desarrollo); el paquete de despliegue los genera. Distintos entre si y de los dos anteriores.
CNS_CHAIN_REF_SECRET=<base64-32-bytes>
CNS_DECISION_MAKER_REF_SECRET=<base64-32-bytes>
CNS_STAFF_ROSTER_CURSOR_SECRET=<base64-32-bytes>
# OPCIONALES. UI: ssr (default) | spa (sirve dist/, requiere npm run build:frontend). Puerto: el web escucha SIEMPRE en 127.0.0.1 (default 3000).
CNS_UI_MODE=spa
PORT=3000
