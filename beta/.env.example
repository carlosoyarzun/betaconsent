# Sin secretos reales. Generar secretos con: openssl rand -base64 48
CNS_ENVIRONMENT=LOCAL
CNS_DATABASE_URL=postgresql://consent_app:CHANGE_ME@127.0.0.1:5432/consent
CNS_SESSION_SECRET=
CNS_PUBLIC_ORIGIN=http://localhost:8080
CNS_SMTP_URL=smtp://127.0.0.1:1025
CNS_SMTP_FROM=no-reply@consent.example.invalid
CNS_MAIL_ALLOWLIST=@example.invalid
CNS_API_KEYS=key1:
PORT=8080
BIND=127.0.0.1
# Opcional (pendiente de integrar, rol consent_mailer):
# CNS_MAILER_DATABASE_URL=
