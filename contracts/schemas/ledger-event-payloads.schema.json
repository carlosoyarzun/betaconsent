{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.consent-app.invalid/it0/schemas/ledger-event-payloads.schema.json",
  "title": "Consent App IT0 — lista blanca de payloads del ledger (integrity.audit_event)",
  "x-api-id": "API-CNS-183",
  "status": "DRAFT",
  "x-it0-only": true,
  "x-spec-source": "specs/state-machines/*.spec.yaml rev. 4 (CA-116; main e1908ed)",
  "description": "Fuente única de la lista blanca por eventType (INV-CM-05). additionalProperties=false: un campo fuera de lista o un valor fuera de enum hace fallar el append. Prohibidos: email, nombre, RUT, token, OTP, IP, HMAC y texto libre. Excluidos por estar deshabilitados en IT0: CONSENT_EXPIRED (C7), CONSENT_SUPERSEDED (C8), DECISION_CONTESTED (M3).",
  "x-governed-by": [
    "common.spec.yaml ledgerEnvelope.payloadPolicy, INV-CM-05",
    "*.spec.yaml events (stream: LEDGER)",
    "DEC-BR-017 §6",
    "ADR-002 §10, §11"
  ],
  "x-disabled-in-it0": [
    "CONSENT_EXPIRED",
    "CONSENT_SUPERSEDED",
    "DECISION_CONTESTED"
  ],
  "$defs": {
    "INVITATION_CREATED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "participationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "enrollmentRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "subjectRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "reissueOfRef": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "invitationRef",
        "participationRef",
        "enrollmentRef",
        "subjectRef",
        "reissueOfRef"
      ]
    },
    "INVITATION_READY": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "consentVersion": {
          "$ref": "common.schema.json#/$defs/Version"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "recipientBinding": {
          "enum": [
            "RECIPIENT_CHANNEL",
            "UNBOUND"
          ]
        }
      },
      "required": [
        "invitationRef",
        "consentVersion",
        "expiresAt",
        "recipientBinding"
      ]
    },
    "INVITATION_SENT": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "deliveryChannel": {
          "enum": [
            "SCHOOL_CHANNEL",
            "CONSENT_APP_EMAIL"
          ],
          "x-pending": [
            "EXT-B / F-014 (DEC-BR-014 §7): valor sin fijar"
          ]
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      },
      "required": [
        "invitationRef",
        "deliveryChannel",
        "expiresAt"
      ],
      "description": "Sin token (INV-IV-03)."
    },
    "INVITATION_TOKEN_ROTATED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invitationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
