# Consent App - plantilla CONSOLIDADA de entorno del paquete de instalacion manual (modo sintetico, perfil LOCAL).
# Gobierna: orden de Carlos 2026-10-18 (PR-F), ADR-003 rev. 7 (host propio), ADR-010 rev. 4 INV-DBR-02 (un rol LOGIN y un usuario de SO por proceso).
#
# SOLO DATOS SINTETICOS. CNS_ENVIRONMENT=LOCAL es el unico perfil soportado fuera de la maquina de desarrollo hoy:
# el IdP del verifier es sintetico y los canales (OTP, enlaces) son sinks en memoria. Ver README-DEPLOY.md, seccion 12.
#
# Esta plantilla NO lleva secretos. tools/deploy/install.sh genera /etc/consent/<proceso>.env (root:root, 0600) con CADA
# bloque "#@ block: <proceso>" de abajo: copia solo las lineas que no empiezan por "#" y sustituye %%MARCADOR%% por:
#   %%PW_<ROL>%%      contrasena aleatoria de ese rol LOGIN de Postgres (hex de 48 caracteres), guardada en /etc/consent/roles.env
#   %%DB_HOST%% %%DB_PORT%% %%DB_NAME%%   conexion a Postgres (por defecto 127.0.0.1, 5432, consent)
#   %%ORIGIN%%        https://consent.lectorpro.cl (opcion --origin)
#   %%UI_MODE%%       spa | ssr (opcion --ui-mode; por defecto spa)
#   %%SECRET_<X>%%    secreto aleatorio base64 de 32 bytes (openssl rand -base64 32), uno distinto por proposito
# Un archivo con un marcador %%...%% o con un valor "<...>" sin reemplazar NO arranca (install.sh y verify.sh lo detectan).
#
# Prohibido en el entorno de cualquier proceso de runtime: PGOPTIONS, PGUSER, PGPASSWORD, PGSERVICE, PGSERVICEFILE, PGPASSFILE y
# variables *MIGRATOR* (assertSafeConnectionUrl / readProcessDatabaseUrl abortan). La URL solo admite ?sslmode, ?sslrootcert, ?connect_timeout.

#@ block: web
# --- consent-web (rol app_rw) ---
# OBLIGATORIA. Perfil. Unico valor soportado hoy: LOCAL (dev.ts aborta con otro).
CNS_ENVIRONMENT=LOCAL
# OBLIGATORIA. Almacen: postgres (memory pierde todo al reiniciar).
CONSENT_STORE=postgres
# OBLIGATORIA. Credencial de app_rw (solo por entorno; el usuario de la URL debe ser exactamente app_rw).
CNS_DATABASE_URL=postgresql://app_rw:%%PW_APP_RW%%@%%DB_HOST%%:%%DB_PORT%%/%%DB_NAME%%
# OBLIGATORIA detras de nginx. Origen publico exacto (esquema + host, sin barra final). Valida el header Origin de los POST (CSRF)
# y debe ser https: las cookies __Host-* son Secure y el navegador no las guarda en http.
CNS_ALLOWED_ORIGIN=%%ORIGIN%%
# OBLIGATORIA. Firma de sesion y raiz de handles/CSRF/sesiones STAFF. base64 estricto, >= 32 bytes. Rotarla cierra todas las sesiones.
CNS_SESSION_SECRET=%%SECRET_SESSION%%
# OBLIGATORIA. HMAC del codigo OTP y del canal opaco. base64 >= 32 bytes. Rotarla invalida los OTP pendientes.
CNS_OTP_SECRET=%%SECRET_OTP%%
# OBLIGATORIA en el paquete (en LOCAL tendria una constante publica de desarrollo). HMAC del chainRef opaco. base64 >= 32 bytes.
CNS_CHAIN_REF_SECRET=%%SECRET_CHAIN_REF%%
# OBLIGATORIA en el paquete (idem). HMAC del decisionMakerRef (v2). base64 >= 32 bytes. Cambiarla cambia los refs ya emitidos.
CNS_DECISION_MAKER_REF_SECRET=%%SECRET_DMREF%%
# OBLIGATORIA en el paquete (idem). Cursor de GET /staff/roster. base64 >= 32 bytes.
CNS_STAFF_ROSTER_CURSOR_SECRET=%%SECRET_ROSTER_CURSOR%%
# Las cinco CNS_*_SECRET deben ser distintas entre si (assertDistinctServerSecrets).
# OPCIONAL. spa = sirve dist/ (React); ssr = HTML del servidor (alternativa mientras no todas las paginas esten migradas). Por defecto ssr si falta.
CNS_UI_MODE=%%UI_MODE%%
# OPCIONAL. Puerto de escucha; el web SIEMPRE escucha en 127.0.0.1 (nginx hace de proxy). Por defecto 3000.
PORT=3000
# OPCIONAL. Retencion P-34 (todas o ninguna; ninguna = desactivada en LOCAL). Dias enteros. Sin valor aprobado: no activar en el paquete.
# CNS_RETENTION_SECURITY_EVENT_DAYS=<DIAS>
# CNS_RETENTION_OTP_BUDGET_DAYS=<DIAS>
# CNS_RETENTION_OTP_VERIFICATION_DAYS=<DIAS>
# CNS_RETENTION_PURGE_RUN_DAYS=<DIAS>

#@ block: worker
# --- consent-worker (rol worker): purga de canjes OIDC y R5-R7 (stub interno, solo LOCAL) ---
# OBLIGATORIA.
CNS_ENVIRONMENT=LOCAL
# OBLIGATORIA. Credencial de worker.
CNS_DATABASE_URL=postgresql://worker:%%PW_WORKER%%@%%DB_HOST%%:%%DB_PORT%%/%%DB_NAME%%

#@ block: platform
# --- consent-platform (rol platform_rw): consola PLATFORM/CASE (/platform/*). NO habilitada por install.sh: sin IdP no tiene login ---
# OBLIGATORIA.
CNS_ENVIRONMENT=LOCAL
# OBLIGATORIA. Credencial de platform_rw.
CNS_DATABASE_URL=postgresql://platform_rw:%%PW_PLATFORM_RW%%@%%DB_HOST%%:%%DB_PORT%%/%%DB_NAME%%
# OPCIONAL. Puerto (127.0.0.1 en LOCAL). Un solo proceso y NINGUN proxy delante (supuesto de seguridad PR-6b): nginx NO publica /platform/.
CNS_PLATFORM_PORT=8788
# OPCIONAL (las tres juntas o ninguna; sin ellas /platform/auth/login responde 404). IdP real: APR-IDP PENDING (Carlos / studio).
# CNS_PLATFORM_IDP_AUTHORIZATION_ENDPOINT=<URL-del-IdP>
# CNS_PLATFORM_IDP_CLIENT_ID=<client-id>
# CNS_PLATFORM_REDIRECT_URI=<URL-de-callback>

#@ block: reconciler
# --- consent-reconciler (rol integrity_reconciler): oneshot por timer (hourly) ---
# OBLIGATORIA.
CNS_ENVIRONMENT=LOCAL
# OBLIGATORIA. Credencial de integrity_reconciler.
CNS_DATABASE_URL=postgresql://integrity_reconciler:%%PW_INTEGRITY_RECONCILER%%@%%DB_HOST%%:%%DB_PORT%%/%%DB_NAME%%

#@ block: chain-verifier
# --- consent-chain-verifier y consent-breakglass-watch (rol integrity_chain_verifier): oneshot por timer. NO lleva CNS_VERIFIER_* ---
# OBLIGATORIA.
CNS_ENVIRONMENT=LOCAL
# OBLIGATORIA. Credencial de integrity_chain_verifier.
CNS_DATABASE_URL=postgresql://integrity_chain_verifier:%%PW_INTEGRITY_CHAIN_VERIFIER%%@%%DB_HOST%%:%%DB_PORT%%/%%DB_NAME%%
# SOLO LOCAL (C7). Permite una base sin tenants ni eventos (recien instalada); sin esto el timer horario falla con exit 1 hasta que haya eventos.
CNS_CHAIN_VERIFIER_ALLOW_EMPTY=true
# OPCIONAL. Lote de lectura por tenant, entero 100..5000 (default 500).
# CNS_CHAIN_VERIFIER_BATCH=500
# La copia local de cabezas (CNS_CHAIN_VERIFIER_STATE_DIR) la fija la unidad systemd (StateDirectory): no va aqui.

#@ block: verifier
# --- consent-verifier (rol integrity_verifier): NO habilitado ni generado por install.sh. Requiere parametros PENDING (P-36, APR-IDP) y K_sub ---
# Solo documentacion. Con IdP sintetico (LOCAL) un operador puede crear /etc/consent/verifier.env a mano con estas variables, todas OBLIGATORIAS:
# CNS_ENVIRONMENT=LOCAL
# CNS_DATABASE_URL=postgresql://integrity_verifier:<SECRETO>@127.0.0.1:5432/consent
# CNS_VERIFIER_ISSUER=<issuer-sintetico>
# CNS_VERIFIER_AUDIENCE=<audience-sintetica>
# CNS_VERIFIER_MAX_AUTH_AGE_SECONDS=<P-36 PENDING: lo fija Carlos>
# CNS_VERIFIER_REQUIRED_ACR_ANY_OF=<APR-IDP PENDING>
# CNS_VERIFIER_SUB_HMAC_KEY_HEX=<K_sub, hex de >= 32 bytes>
