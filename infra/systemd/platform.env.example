# Plantilla (sin secretos). Real: /etc/consent/platform.env, root:root, modo 0600.
CNS_ENVIRONMENT=LOCAL
CNS_DATABASE_URL=postgresql://platform_rw:<SECRETO>@<host>:5432/<db>
CNS_PLATFORM_PORT=8788

# ADR-010 rev. 5 PR-6b (G-6). Fuera de LOCAL TODO lo siguiente es OBLIGATORIO (sin defaults; el proceso no arranca sin ello).
# RED: en staging la plataforma (/platform/*) es accesible SOLO por red privada o VPN. Esa restriccion es de INFRAESTRUCTURA (firewall del host + IPAddressAllow de la unidad, a completar con los
# datos de infraestructura de studio, pendientes); NO esta implementada ni verificada aqui. El proceso solo exige un bind explicito (IP concreta, nunca 0.0.0.0/::) y una allowlist de origen (defensa en profundidad).
# CNS_PLATFORM_BIND_ADDRESS=<ip-interna-de-la-VPN>
# CNS_PLATFORM_ALLOWED_CIDRS=<cidr-de-la-VPN>[,<otro-cidr>]
# Limites (valores iniciales aprobados el 2026-10-15; configurables): P-49 por IP truncada (si la VPN hace NAT el contador es compartido: limitacion aceptada en IT0b; con IP interna por cliente usar prefijo 32),
# P-50 por operador (ventana en segundos), P-51 (base de datos), P-53 tope global de flujos AWAITING_CALLBACK (SIN valor aprobado: Carlos/studio).
# CNS_PLATFORM_P49_MAX=20
# CNS_PLATFORM_P49_WINDOW_SECONDS=900
# CNS_PLATFORM_P49_IPV4_PREFIX=24
# CNS_PLATFORM_P50_MAX=30
# CNS_PLATFORM_P50_WINDOW_SECONDS=60
# CNS_PLATFORM_P51_MAX=5
# CNS_PLATFORM_P51_WINDOW_SECONDS=600
# CNS_PLATFORM_P53_MAX_AWAITING=<PENDIENTE>
# IdP (adaptador real apagado hasta IT0b: APR-IDP, P-45, TP-02). Las tres juntas o ninguna; sin ellas /platform/auth/login responde 404.
# CNS_PLATFORM_IDP_AUTHORIZATION_ENDPOINT=https://<idp>/authorize
# CNS_PLATFORM_IDP_CLIENT_ID=<client-id>
# CNS_PLATFORM_REDIRECT_URI=https://<host-platform>/platform/auth/callback
