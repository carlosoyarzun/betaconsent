{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.consent-app.invalid/it0/schemas/rights-case.schema.json",
  "title": "RightsCase (proyección IT0)",
  "x-api-id": "API-CNS-190",
  "status": "DRAFT",
  "x-it0-only": true,
  "x-spec-source": "specs/state-machines/*.spec.yaml rev. 4c–4f + specs/adapters/lectorpro-beta.spec.yaml (CA-116; main @ bc945d5, PR #6)",
  "x-governed-by": [
    "specs/state-machines/rights-case.spec.yaml",
    "SM-CNS-001 §5.2 (v7)",
    "ADR-002 §10",
    "DEC-BR-018 (ACCEPTED 2026-09-27)"
  ],
  "x-states": [
    "OPEN",
    "CONTACTING",
    "IN_VERIFICATION",
    "RESOLVED",
    "WITHDRAWN"
  ],
  "x-transitions": [
    {
      "id": "RC0",
      "from": null,
      "to": "OPEN",
      "via": "POST /staff/rights-reports"
    },
    {
      "id": "RC1",
      "from": null,
      "to": "OPEN",
      "via": "POST /rights-case/open (fuente BEARER); fuente SYSTEM desde R9 en la misma tx, sin HTTP (GRD-RC-16, GRD-CM-15)"
    },
    {
      "id": "RC1c",
      "from": null,
      "to": "OPEN",
      "via": "sin operación",
      "enabled": false,
      "reason": "R13-2; LD-03/LD-04"
    },
    {
      "id": "RC2",
      "from": "OPEN",
      "to": "CONTACTING",
      "via": "worker SYSTEM_GUARD (primera acción; RV0 fuente SYSTEM al canal ligado); fuente = rol worker (GRD-CM-15, SEC-CNS-013 N-4c-02)"
    },
    {
      "id": "RC2u",
      "from": "OPEN",
      "to": "CONTACTING",
      "via": "POST /rights-case/resume (POST explícito con CSRF desde la página del caso servida por /m/; el GET no transiciona, F-011)",
      "actor": {
        "ref": "UNVERIFIED_BEARER"
      },
      "command": "ConfirmCaseReturnViaHandle",
      "governedBy": [
        "rights-case.spec RC2u rev. 4f (F-CT-10, Carlos 2026-09-27)",
        "DEC-BR-018 (F-005, R13-5)"
      ]
    },
    {
      "id": "RC3",
      "from": "CONTACTING",
      "to": "IN_VERIFICATION",
      "via": "POST /rights-case/revocation-intent"
    },
    {
      "id": "RC3a",
      "from": "CONTACTING",
      "to": "IN_VERIFICATION",
      "via": "POST /rights-case/revocation-intent (Revocation abierta)",
      "pending": [
        "P-v7-5"
      ]
    },
    {
      "id": "RC4.RESOLVED",
      "from": "IN_VERIFICATION",
      "to": "RESOLVED",
      "via": "POST /platform/rights-cases/{caseRef}/close"
    },
    {
      "id": "RC4.WITHDRAWN",
      "from": "IN_VERIFICATION",
      "to": "WITHDRAWN",
      "via": "POST /platform/rights-cases/{caseRef}/close"
    },
    {
      "id": "RC5",
      "from": "CONTACTING",
      "to": "RESOLVED",
      "via": "POST /platform/rights-cases/{caseRef}/close"
    },
    {
      "id": "RC6",
      "from": "CONTACTING",
      "to": "WITHDRAWN",
      "via": "POST /platform/rights-cases/{caseRef}/close"
    }
  ],
  "$defs": {
    "RightsCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "tenantRef": {
          "$ref": "common.schema.json#/$defs/TenantRef"
        },
        "chainRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "revokedDecisionRef": {
          "$ref": "common.schema.json#/$defs/Ref",
          "description": "Decisión del ciclo del caso, fijada en servidor al abrir (GRD-RC-02) y nunca modificada (R14-C, SEC N2-03). UNIQUE parcial (tenant_id, chain_ref, revoked_decision_ref) de casos no terminales.",
          "x-governed-by": [
            "DEC-BR-018 R14-C (A-08, A-25, A-26: ≤1 revocación abierta por decisión revocada)"
          ]
        },
        "revocationRef": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "common.schema.json#/$defs/EscalationReason"
        },
        "initiatedVia": {
          "$ref": "common.schema.json#/$defs/InitiatedVia"
        },
        "state": {
          "enum": [
            "OPEN",
            "CONTACTING",
            "IN_VERIFICATION",
            "RESOLVED",
            "WITHDRAWN"
          ]
        },
        "slaDueAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "overdue": {
          "type": "boolean"
        },
        "openedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "closedAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "caseRef",
        "tenantRef",
        "chainRef",
        "revokedDecisionRef",
        "origin",
        "initiatedVia",
        "state",
        "sequence"
      ],
      "description": "Sin estado de expiración ni de rechazo; nunca deniega (INV-RC-01). PARKED no existe (LD-04). case_contact vive solo en pii.case_contact y no forma parte de la proyección. ≤1 caso no terminal por ciclo (tenant_id, chainRef, revokedDecisionRef; GRD-RC-02)."
    }
  }
}
