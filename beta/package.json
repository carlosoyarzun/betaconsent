{
  "name": "consent-beta",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "migrate": "node src/db/migrate-cli.ts",
    "ci": "npm run typecheck && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:frontend && npm run build:frontend && npm run check:dist",
    "test:contract": "node --test --test-concurrency=1 \"tests/contract/**/*.test.ts\"",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "build:frontend": "npm run typecheck:frontend && vite build --config frontend/vite.config.ts",
    "test:frontend": "vitest run --config frontend/vite.config.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "check:dist": "node scripts/check-dist.ts",
    "start": "node src/server/main.ts"
  },
  "dependencies": {
    "nodemailer": "10.1.7",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
