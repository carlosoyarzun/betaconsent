      ]
    },
    "DOWNSTREAM_ERASURE_ATTESTED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        }
      },
      "required": [
        "revocationRef"
      ]
    },
    "REVOCATION_FAILED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "reasonCode": {
          "const": "WITHDRAWN_BY_REQUESTER"
        }
      },
      "required": [
        "revocationRef",
        "reasonCode"
      ]
    },
    "REVOCATION_ESCALATED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revocationRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "caseRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "reasonCode": {
          "$ref": "common.schema.json#/$defs/EscalationReason"
        }
      },
      "required": [
        "revocationRef",
        "caseRef",
        "reasonCode"
      ]
    },
    "RIGHTS_CASE_OPENED": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
        "reasonCode": {
          "$ref": "common.schema.json#/$defs/EscalationReason"
        },
        "initiatedVia": {
          "$ref": "common.schema.json#/$defs/InitiatedVia"
        }
      },
      "required": [
        "caseRef",
        "reasonCode",
        "initiatedVia"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "reasonCode": {
                "const": "SCHOOL_REPORTED"
              }
            },
            "required": [
              "reasonCode"
            ]
          },
          "then": {
            "properties": {
              "initiatedVia": {
                "const": "SCHOOL_REPORT"
              }
            }
          },
          "else": {
            "properties": {
              "initiatedVia": {
                "const": "DECISION_MAKER"
              }
            }
          }
        }
      ]
    },
    "RIGHTS_CASE_CONTACTING": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseRef": {
          "$ref": "common.schema.json#/$defs/Ref"
        },
